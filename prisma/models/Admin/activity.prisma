model Activity {
    id                          Int            @id @default(autoincrement())
    title                       String         @unique
    icon                        String?
    url                         String

    department_id               Int            // Define o departamento em que a atividade pertence.
    department                  Department     @relation(fields: [department_id], references: [id], onDelete: Restrict)

    sector_id                   Int?           // Define o setor que percente, independente do negócio
    sector                      Sector?        @relation(fields: [sector_id], references: [id], onDelete: Restrict)

    business_unit_activities    BusinessUnitActivity[]
    user_activities             UserActivity[]
}
