model BusinessUnit {
  id     Int     @id @default(autoincrement())
  title  String  @unique
  photos String? //Quando for para postgres SQL
  cnpj   String

  business_unit_activity BusinessUnitActivity[]

  // ADMIN
  departments       Department[]
  group_users       GroupUser[]
  process_instances ProcessInstance[]

  // AUTH
  users           User[]
  user_sessions   UserSession[]
  user_activities UserActivity[]

  // ORGANIZATION
  buildings                   Building[]
  building_lease_contract     BuildingLeaseContract[]
  building_contract_amendment BuildingContractAmendment[]
  localizations               Localization[]
  space_type                  SpaceType[]
  blocks                      Block[]
  floors                      Floor[]
  rooms                       Room[]

  cost_centers                CostCenter[]
  payment_control             PaymentControl[]

  contracts                   Contract[]

  // FACILITIES
  projects            Project[]
  project_allocations ProjectAllocation[]
  project_documents   ProjectDocument[]

  // SERVIÇES

  // PEOPLE
  peoples              People[]
  allocations          Allocation[]
  people_relationships PeopleRelationship[]
  jobs                 Job[]
  people_jobs          PeopleJob[]

  // SUPPLY-CHAIN
  procurements      Procurement[]
  procurement_items ProcurementItem[]
  suppliers         Supplier[]
  inventory_items   InventoryItem[]

  // MAINTENANCE
  maintenance Maintenance[]

  //SOFT DELETE
  created_at DateTime @default(now())
  created_by Int?

  updated_at DateTime? @updatedAt
  updated_by Int?

  deleted_at DateTime?
  deleted_by Int?
}
