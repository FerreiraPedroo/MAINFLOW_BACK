
model Party {
  id                    Int     @id @default(autoincrement())

  legal_name            String // Razão social ou Nome
  trade_name            String // Nome fantasia
  party_type            String // Pessoa Jurídica, Pessoa Fisica
  tax_id                String // CNPJ/CPF
  role                  Json  @default("[]") // Tipo de fornecedor CLIENT, SUPPLY
  contact               Json  // Contatos da empresa, nome, tel, email...
  logo                  String // Logo da empresa.

  payment_submissions   PaymentSubmission[]
  
  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?
}