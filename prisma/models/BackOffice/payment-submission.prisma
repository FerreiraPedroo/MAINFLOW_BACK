
model PaymentSubmission {
  id                    Int     @id @default(autoincrement())

  invoice_number        String    // Numero da NF/FATURA/BOLETO/Etc. que identifica aquele pagamento.
  invoice_type          String    // Tipo de documento. Ex: Boleto, Fatura, Nota fiscal, Nota de débito.
  invoice_date          DateTime  // Data de emissão do documento.
  due_date              DateTime  // Data de vencimento. Ex: 2026-30-05T21:00:00:000Z
  billing_period        DateTime  // Referente ao faturamento. Ex:2026-30-01 ... mas somente o mês que é considerado.
  total_amount          Float     // Valor da NF/FATURA/BOLETO/etc.

  payment_send_date     DateTime  // Data de envio da NF/FATURA/BOLETO para o financeiro.
  attached_document     String?     // Um array de strings com a url do documento.
  
  description           String?

  business_partner_id   Int
  business_partner      BusinessPartner     @relation(fields:[business_partner_id], references:[id], onDelete: Restrict)

  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?
}