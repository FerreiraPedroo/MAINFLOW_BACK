model Address {
  id                  Int           @id @default(autoincrement())
  zone                String        // Área em que está. Ex: Zona Norte (ZN), ZonaOeste (ZO)
  short_address       String
  full_address        String
  map_google          String?
  coordinate          String?
  photo               String?       //Quando for para postgres SQL
  status              String
  
  business_unit_id    Int
  business_unit       BusinessUnit  @relation(fields:[business_unit_id], references:[id])

  @@unique([business_unit_id, full_address, short_address])

  Localization        Localization[]
  
  //SOFT DELETE
  created_at          DateTime      @default(now())
  created_by          Int?

  updated_at          DateTime?     @updatedAt
  updated_by          Int?

  deleted_at          DateTime?
  deleted_by          Int?
}
