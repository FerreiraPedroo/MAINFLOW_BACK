model Localization {
  id                Int         @id @default(autoincrement())
  title             String
  block_id          Int
  block             Block       @relation(fields: [block_id], references: [id])
  floor_id          Int
  floor             Floor       @relation(fields: [floor_id], references: [id])
  space_type_id     Int
  space_type        SpaceType   @relation(fields: [space_type_id], references: [id])
  address_id        Int
  address           Address     @relation(fields: [address_id], references: [id])
  status            String

  business_unit_id  Int
  business_unit     BusinessUnit @relation(fields: [business_unit_id], references: [id])
  
  //SOFT DELETE
  created_at          DateTime      @default(now())
  created_by          Int?

  updated_at          DateTime?     @updatedAt
  updated_by          Int?

  deleted_at          DateTime?
  deleted_by          Int?
}
