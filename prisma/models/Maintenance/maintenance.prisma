
model Maintenance {
  id                    Int     @id @default(autoincrement())

  description           String
  photo                 String?

  open_date             DateTime
  scheduled_date        DateTime?
  finish_date           DateTime?
  
  status                String
  classification        String?
  priority              String?

  localization_id       Int
  localization          Localization  @relation(fields:[localization_id], references:[id], onDelete: Restrict)

  user_id               Int
  user                  User          @relation(fields:[user_id], references:[id], onDelete: Restrict)

  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?
}