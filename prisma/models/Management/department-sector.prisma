model DepartmentSector {
    id                  Int     @id     @default(autoincrement())
    order               Int

    department_id       Int
    department          Department      @relation(fields:[department_id], references:[id])
    
    sector_id           Int?
    sector              Sector?         @relation(fields:[sector_id], references:[id])
    
    process_item_id     Int
    process_item        ProcessItem     @relation(fields:[process_item_id], references:[id])
    
    business_unit_id    Int
    business_unit       BusinessUnit    @relation(fields:[business_unit_id], references:[id])
}