model Sector {
    id                         Int             @id     @default(autoincrement())
    title                      String          @unique
    icon                       String?
    
    department_id               Int
    department                  Department      @relation(fields: [department_id], references:[id])

    process_item                ProcessItem[]
   
    business_unit_process       BusinessUnitProcess[]
    user_department_sector      UserDepartmentSector[]
}