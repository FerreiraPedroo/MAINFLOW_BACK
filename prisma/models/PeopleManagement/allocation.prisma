/**
  ALOCAÇÕES
  - é onde uma Pessoa é alocada em um departamento, setor ou contrato se for o caso.
  - inicialmente uma Pessoa só pode ser alocada em uma unica alocação.
  - sempre que a alocação da Pessoa mudar deve ser registrado a data de inicio e o fim.
*/
model Allocation {
  id              Int       @id @default(autoincrement())
  people_id       Int       @unique
  people          People    @relation(fields: [people_id], references: [id])
  department_id   Int
  department      Department  @relation(fields: [department_id], references: [id])
  sector_id       Int
  sector          Sector      @relation(fields: [sector_id], references: [id])
  contract_id     Int?
  start_date      String
  end_date        String?
}

