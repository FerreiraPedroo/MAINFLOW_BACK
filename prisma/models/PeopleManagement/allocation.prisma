/**
  ALOCAÇÕES
  - é onde uma Pessoa é alocada em um departamento, setor ou contrato se for o caso.
  - inicialmente uma Pessoa só pode ser alocada em uma unica alocação.
  - sempre que a alocação da Pessoa mudar deve ser registrado a data de inicio e o fim.
*/
model Allocation {
  id              Int         @id @default(autoincrement())
  people_id       Int         @unique
  people          People      @relation(fields: [people_id], references: [id], onDelete: Restrict)
  department_id   Int
  department      Department  @relation(fields: [department_id], references: [id], onDelete: Restrict)
  sector_id       Int?
  sector          Sector?     @relation(fields: [sector_id], references: [id], onDelete: Restrict)
  
  contract_id     Int?
  start_date      String
  end_date        String?

  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id])
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?
}

