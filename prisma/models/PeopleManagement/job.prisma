model Job {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  cbo                   String?
  status                String
  description           String?


  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)

  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?
}

