/**
  PESSOA
  - inicialmente são somente os funcionários.
*/
model People {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  birth_date            String
  registration_number   String?  @unique
  photo                 String?
  sex                   String?
  hire_date             String?
  termination_date     String?

  allocation            Allocation?
}

