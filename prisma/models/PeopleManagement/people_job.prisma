model PeopleJob {
  id                    Int           @id   @default(autoincrement())
  people_id             Int
  people                People        @relation(fields:[people_id],references: [id])

  job_id                Int
  job                   Job          @relation(fields:[job_id], references:[id], onDelete: Restrict)

  start_date            DateTime
  end_date              DateTime?
  comment               String?

  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?

}