model PeopleRelationship {
  id                Int       @id   @default(autoincrement())
  people_id         Int
  people            People    @relation("Person",fields:[people_id],references: [id])
  kinship           String    // Parentesco
  related_person_id Int?
  related_person    People?    @relation("Relative", fields:[related_person_id],references: [id])

  name              String?
  photo             String?
  start_date        DateTime?
  end_date          DateTime?
  comment           String

  business_unit_id      Int
  business_unit         BusinessUnit  @relation(fields: [business_unit_id], references: [id], onDelete: Restrict)
  
  //SOFT DELETE
  created_at            DateTime      @default(now())
  created_by            Int?

  updated_at            DateTime?     @updatedAt
  updated_by            Int?

  deleted_at            DateTime?
  deleted_by            Int?

}