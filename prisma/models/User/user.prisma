model User {
  id                      Int          @id @default(autoincrement())
  email                   String
  password                String
  name                    String
  birth_date              String?
  photo                   String?

  groups                  GroupUser[]

  business_unit_id        Int
  business_unit           BusinessUnit @relation(fields: [business_unit_id], references: [id])

  user_data               UserData?
  user_session            UserSession?

  process_instances       ProcessInstance[]
  process_step_instances  ProcessStepInstance[]
  
  @@unique([business_unit_id, email])

  //SOFT DELETE
  created_at          DateTime      @default(now())
  created_by          Int?

  updated_at          DateTime?     @updatedAt
  updated_by          Int?

  deleted_at          DateTime?
  deleted_by          Int?
}
