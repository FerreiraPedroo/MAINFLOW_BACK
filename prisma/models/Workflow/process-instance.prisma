//  Quase todo modelo tem uma lista de processos.
//  Quando abre um CRUD básico é criado um processo que é atrelado.
//  Projeto -> novo projeto = cria uma instancia do processo de criar um projeto e
//                            atrela ao registro do processo.
//  
//
//

model ProcessInstance {
    id                          Int                     @id @default(autoincrement())

    status                      String                  // é o status do processo em geral.

    process_model_id            Int
    process_model               ProcessModel            @relation(fields: [process_model_id], references: [id])
    process_step_instance       ProcessStepInstance[]
    
    user_id                     Int                     // Identifica o usuário que criou esse processo.
    user                        User                    @relation(fields: [user_id], references: [id])
    
    business_unit_id            Int                     // Unidade de negócio que pertence o processo.
    business_unit               BusinessUnit            @relation(fields: [business_unit_id], references: [id])
    
    process_item_id             Int
    process_item                ProcessItem             @relation(fields:[process_item_id], references: [id])


    project                     Project[]
}